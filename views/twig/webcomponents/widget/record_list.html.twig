<ff-record-list {% if oViewConf.getFFBoolConfigParam("ffUseSsr") %} ssr {% endif%} unresolved class="row gridView list-container" subscribe="{{ subscribe|default("true") }}">
    <template data-role="record">
        <ff-record class="productData col-xs-12 col-sm-6 col-md-4 productBox">
            <div class="card product-card">
                <div class="product-img-wrapper">
                    <a data-anchor="{{ '{{ masterValues.Deeplink }}' }}" data-redirect="{{ '{{ masterValues.Deeplink }}' }}" data-redirect-target="_self" title="{{ '{{ masterValues.Name }}' }}">
                        <img width="350" height="220" data-image="{{ '{{ masterValues.ImageUrl }}' }}" alt="{{ '{{ masterValues.Name }}' }}" class="product-img" />
                    </a>
                </div>

                <div class="card-body">
                    <div class="h5 card-title text-center">
                        <a data-redirect="{{ '{{ masterValues.Deeplink }}' }}" data-redirect-target="_self" data-anchor="{{ '{{ masterValues.Deeplink }}' }}" title="{{ '{{ masterValues.Name }}' }}">
                            <span>{{ '{{ masterValues.Name }}' }}</span>
                        </a>
                    </div>

                    <div class="d-flex flex-column price">
                        <span class="lead text-nowrap">{{ '{{ $ masterValues.Price }}' }} *</span>
                    </div>

                    <div class="listDetails text-center">
                        <div class="actions text-center">
                            <div class="btn-group">
                                <a class="btn btn-primary" data-redirect="{{ '{{ masterValues.Deeplink }}' }}" data-redirect-target="_self" data-anchor="{{ '{{ masterValues.Deeplink }}' }}">{{ translate({ ident: "MORE_INFO" }) }}</a>

                                {% if oViewConf.getFFBoolConfigParam("ffCartBtn") %}
                                    <form action="{{ oViewConf.getSelfActionLink()|raw }}" method="post" class="add-to-cart-form">
                                        {{ oViewConf.getHiddenSid()|raw }}
                                        <input type="hidden" name="cl" value="addToCart">
                                        <input type="hidden" name="fnc" value="addToCart">
                                        <input type="hidden" name="productNumber" value="{{ '{{ variantValues.0.ProductNumber }}' }}">
                                        <button type="submit" class="btn btn-primary ff-cart-btn"> {{ translate({ ident: "TO_CART" }) }}</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </ff-record>
    </template>
</ff-record-list>

{% if oViewConf.getFFBoolConfigParam("ffUseSsr") and ssr_ff_response is defined and ssr_ff_response is not empty  %}
    <script type="text/javascript">
        document.addEventListener(`ffCoreReady`, ({ factfinder }) => {
            factfinder.response.dispatch.ssrSearch({{ ssr_ff_response|raw }});
        });
    </script>
{% endif %}


